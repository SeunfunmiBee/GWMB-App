{
  "expo": {
    "name": "GWMB – Girls Who Mean Business",
    "slug": "gwmb-girls-who-mean-business",
    "owner": "girls-who-mean-business",
    "scheme": "gwmb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/gwmb-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.girlswhomeanbusiness.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.girlswhomeanbusiness.app",
      "adaptiveIcon": {
        "backgroundColor": "#A81455",
        "foregroundImage": "./assets/branding/gwmb-mark-transparent.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/branding/gwmb-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#E62B7F",
          "defaultChannel": "gwmb-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#A81455",
          "image": "./assets/branding/gwmb-mark-transparent.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "GWMB uses the photo you choose as your profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26765876-ea6a-49ff-b894-91e32b9edc30"
      }
    }
  }
}
